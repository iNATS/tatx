# Tatx Platform - Production Environment Variables
# Copy this file to .env.production and fill in your values

# ===========================================
# Database Configuration
# ===========================================
DB_USER=tatx
DB_PASSWORD=CHANGE_THIS_SECURE_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tatx_db

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PASSWORD=CHANGE_THIS_SECURE_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHARACTER_SECRET_KEY
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# Domain Configuration
# ===========================================
DOMAIN=yourdomain.com
WWW_DOMAIN=www.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# ===========================================
# Application URLs
# ===========================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
CUSTOMER_APP_URL=https://yourdomain.com
ADMIN_DASHBOARD_URL=https://admin.yourdomain.com

# ===========================================
# OAuth Configuration (Optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# ===========================================
# Payment Gateway Configuration (Optional)
# ===========================================
# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# HyperPay (Saudi Arabia)
HYPERPAY_API_KEY=
HYPERPAY_ENTITY_ID=
HYPERPAY_CHECKOUT_ID=

# Tabby (BNPL)
TABBY_API_KEY=
TABBY_MERCHANT_ID=

# Tamara (BNPL)
TAMARA_API_KEY=
TAMARA_MERCHANT_ID=

# ===========================================
# Email Configuration (Optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tatx.com

# ===========================================
# SMS Configuration (Optional)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Unifonic (Saudi Arabia)
UNIFONIC_API_KEY=
UNIFONIC_SENDER_ID=

# ===========================================
# Push Notification Configuration
# ===========================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ===========================================
# Storage Configuration (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=tatx-uploads

# Cloudflare R2 (Alternative)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ===========================================
# Maps Configuration
# ===========================================
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ===========================================
# Monitoring & Analytics (Optional)
# ===========================================
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=

# ===========================================
# Security
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ===========================================
# Node.js Configuration
# ===========================================
NODE_ENV=production
PORT=3000
