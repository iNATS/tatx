{
  "extends": "@tatx/config/tsconfig.next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "../../packages/config/next-env.d.ts",
    "../../packages/config/**/*.ts",
    "../../packages/config/**/*.tsx",
    "../../packages/config/.next/types/**/*.ts",
    ".next/types/**/*.ts"
  ]
}
