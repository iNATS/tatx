# Tatx Payment Service Configuration

# Server
PORT=3007
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tatx?schema=public"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug

# ============================================
# HyperPay Configuration (Saudi Arabia - MADA, STC Pay)
# ============================================
HYPERPAY_SANDBOX=true
HYPERPAY_ENTITY_ID=your-entity-id
HYPERPAY_API_KEY=your-api-key
HYPERPAY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# Stripe Configuration (International Cards)
# ============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# Tabby Configuration (BNPL - Buy Now Pay Later)
# ============================================
TABBY_SANDBOX=true
TABBY_API_KEY=your-tabby-api-key
TABBY_WEBHOOK_SECRET=your-tabby-webhook-secret

# ============================================
# Tamara Configuration (BNPL - Buy Now Pay Later)
# ============================================
TAMARA_SANDBOX=true
TAMARA_API_KEY=your-tamara-api-key
TAMARA_WEBHOOK_SECRET=your-tamara-webhook-secret

# ============================================
# Apple Pay Configuration
# ============================================
APPLE_PAY_MERCHANT_ID=merchant.com.tatx.payment
APPLE_PAY_MERCHANT_CERTIFICATE=path/to/apple-pay-cert.pem
APPLE_PAY_PROCESSOR=STRIPE

# ============================================
# Google Pay Configuration
# ============================================
GOOGLE_PAY_MERCHANT_ID=your-google-pay-merchant-id
GOOGLE_PAY_GATEWAY_MERCHANT_ID=your-gateway-merchant-id
GOOGLE_PAY_PROCESSOR=STRIPE

# ============================================
# PayPal Configuration (Optional)
# ============================================
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_SANDBOX=true

# ============================================
# Moyasar Configuration (Optional - Saudi Arabia)
# ============================================
MOYASAR_API_KEY=your-moyasar-api-key
MOYASAR_SECRET_KEY=your-moyasar-secret-key
MOYASAR_SANDBOX=true

# ============================================
# Payment Settings
# ============================================
DEFAULT_CURRENCY=SAR
ENABLE_WALLET=true
ENABLE_AUTO_TOPUP=true
ENABLE_SPLIT_PAYMENT=true
MAX_SPLIT_PAYMENTS=3

# ============================================
# Security
# ============================================
ENCRYPTION_KEY=your-32-character-encryption-key
JWT_SECRET=your-jwt-secret-key
WEBHOOK_IP_WHITELIST=
