// Tatx Super-App Platform - Prisma Schema
// Uber + HungerStation + Courier + Grocery Super-App
// Optimized for Saudi Arabia Market

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// Enums
// ===========================================

enum UserRole {
  CUSTOMER
  DRIVER
  MERCHANT
  ADMIN
  SUPPORT
}

enum RideStatus {
  REQUESTED
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVERS_FOUND
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  WALLET
  APPLE_PAY
  GOOGLE_PAY
  MADA
  STC_PAY
  TABBY
  TAMARA
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum VehicleType {
  ECONOMY
  COMFORT
  PREMIUM
  LUXURY
  VAN
  MOTORCYCLE
  BICYCLE
  TRUCK
}

enum RideCategory {
  REGULAR
  EXPRESS
  SCHEDULED
  SHARED
  BUSINESS
  FAMILY
}

enum ServiceType {
  RIDE
  FOOD_DELIVERY
  GROCERY_DELIVERY
  PACKAGE_DELIVERY
  COURIER
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
  INACTIVE
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  VERIFIED
}

enum OrderType {
  FOOD
  GROCERY
  COURIER
  PHARMACY
}

enum DeliveryPriority {
  STANDARD
  EXPRESS
  SCHEDULED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum TwoFactorStatus {
  ENABLED
  DISABLED
  BACKUP
}

// ===========================================
// Core User Models
// ===========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String    @unique
  password      String
  firstName     String
  firstNameAr   String?   // Arabic first name
  lastName      String
  lastNameAr    String?   // Arabic last name
  avatar        String?
  role          UserRole  @default(CUSTOMER)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(true) // Phone verification is primary in KSA
  isActive      Boolean   @default(true)
  isBlocked     Boolean   @default(false)
  blockReason   String?
  language      String    @default("ar") // ar or en
  timezone      String    @default("Asia/Riyadh")
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Security
  twoFactorSecret String?
  twoFactorStatus TwoFactorStatus @default(DISABLED)
  backupCodes   String[]
  devices       Device[]
  
  // Relations
  customer      Customer?
  driver        Driver?
  merchant      Merchant?
  admin         Admin?
  payments      Payment[]
  notifications Notification[]
  reviews       Review[]
  referrals     Referral[] @relation("referrals")
  referredBy    Referral[] @relation("referredBy")
  subscriptions Subscription?
  supportTickets SupportTicket[] @relation("createdBy")
  assignedTickets SupportTicket[] @relation("assignedTo")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceType  String   // IOS, ANDROID, WEB
  deviceName  String?
  osVersion   String?
  appVersion  String?
  pushToken   String?
  ipAddress   String?
  isTrusted   Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([pushToken])
}

model Customer {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddressId String?
  savedAddresses  Address[]
  rides           Ride[]   @relation("rider")
  orders          Order[]
  wallet          Wallet?
  loyaltyPoints   Int      @default(0)
  totalSpent      Decimal  @default(0)
  totalRides      Int      @default(0)
  totalOrders     Int      @default(0)
  preferences     Json?    // { dietaryRestrictions, favoriteRestaurants, etc. }
  vipLevel        String   @default("REGULAR") // REGULAR, SILVER, GOLD, PLATINUM
  subscriptionId  String?
  subscription    Subscription?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?  // "Home", "Work", "المنزل", "العمل"
  labelAr     String?
  address     String
  addressAr   String?  // Arabic address
  city        String   // Riyadh, Jeddah, Dammam, etc.
  district    String?  // Neighborhood
  districtAr  String?
  state       String?
  country     String   @default("Saudi Arabia")
  postalCode  String
  latitude    Decimal?
  longitude   Decimal?
  instructions String?
  instructionsAr String?
  isDefault   Boolean  @default(false)
  type        String   @default("RESIDENTIAL") // RESIDENTIAL, COMMERCIAL, LANDMARK
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([city])
  @@index([latitude, longitude])
}

// ===========================================
// Subscription & Membership
// ===========================================

model Subscription {
  id              String   @id @default(cuid())
  customerId      String   @unique
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime
  endDate         DateTime
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  autoRenew       Boolean  @default(true)
  totalSavings    Decimal  @default(0)
  ridesTaken      Int      @default(0)
  ordersPlaced    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([endDate])
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  nameAr          String?
  description     String?
  descriptionAr   String?
  price           Decimal
  currency        String   @default("SAR")
  billingCycle    String   @default("MONTHLY") // WEEKLY, MONTHLY, YEARLY
  trialDays       Int      @default(14)
  benefits        Json     // { freeDelivery: true, rideDiscount: 0.15, prioritySupport: true }
  rideDiscount    Decimal  @default(0)
  deliveryDiscount Decimal @default(0)
  freeDeliveries  Int      @default(0)
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false)
  subscribers     Subscription[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

// ===========================================
// Driver Models
// ===========================================

model Driver {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          DriverStatus @default(OFFLINE)
  rating          Decimal      @default(5.0)
  totalRides      Int          @default(0)
  totalEarnings   Decimal      @default(0)
  vehicleId       String?
  vehicle         Vehicle?
  documents       DriverDocument[]
  currentLocation Location?
  rides           Ride[]
  earnings        Earning[]
  availability    DriverAvailability?
  serviceAreas    DriverServiceArea[]
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectedReason  String?
  backgroundCheckStatus String @default("PENDING")
  backgroundCheckDate DateTime?
  insuranceExpiry DateTime?
  medicalExpiry   DateTime?
  canAcceptRides  Boolean      @default(false)
  canAcceptDelivery Boolean    @default(false)
  maxDeliveryRadius Decimal    @default(10.0)
  hourlyRate      Decimal?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([rating])
}

model DriverServiceArea {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  city        String
  districts   String[] // Array of district names
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([driverId])
  @@index([city])
}

model Vehicle {
  id              String      @id @default(cuid())
  driverId        String      @unique
  driver          Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type            VehicleType
  category        RideCategory @default(REGULAR)
  make            String
  model           String
  year            Int
  color           String
  colorAr         String?
  licensePlate    String      @unique
  licensePlateAr  String?     // Arabic license plate
  registrationNo  String      @unique
  vin             String?     // Vehicle Identification Number
  insuranceExpiry DateTime
  insuranceProvider String?
  insurancePolicyNo String?
  inspectionExpiry DateTime?
  documents       VehicleDocument[]
  capacity        Int         @default(4) // Passenger capacity
  features        String[]    // ["AC", "WIFI", "CHILD_SEAT", "WHEELCHAIR"]
  photos          String[]
  isActive        Boolean     @default(true)
  isVerified      Boolean     @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([driverId])
  @@index([licensePlate])
  @@index([type])
}

model DriverDocument {
  id          String        @id @default(cuid())
  driverId    String
  driver      Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type        String        // "LICENSE", "INSURANCE", "REGISTRATION", etc.
  documentUrl String
  status      DocumentStatus @default(PENDING)
  expiryDate  DateTime?
  verifiedBy  String?
  verifiedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([driverId])
  @@index([type])
}

model VehicleDocument {
  id          String        @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  documentUrl String
  status      DocumentStatus @default(PENDING)
  expiryDate  DateTime?
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([vehicleId])
}

model DriverAvailability {
  id          String   @id @default(cuid())
  driverId    String   @unique
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  monday      Json?    // { start: "09:00", end: "17:00" }
  tuesday     Json?
  wednesday   Json?
  thursday    Json?
  friday      Json?
  saturday    Json?
  sunday      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([driverId])
}

// ===========================================
// Merchant & Restaurant Models
// ===========================================

model Merchant {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  businessNameAr String?
  businessType  String     // RESTAURANT, GROCERY, PHARMACY, RETAIL
  taxId         String?
  taxNumber     String?    // Saudi VAT number
  crNumber      String?    // Commercial Registration
  phone         String
  email         String
  logo          String?
  banner        String?
  description   String?
  descriptionAr String?
  isActive      Boolean    @default(false)
  verifiedAt    DateTime?
  rating        Decimal    @default(0)
  totalOrders   Int        @default(0)
  commissionRate Decimal   @default(0.15)
  payoutAccount String?    // IBAN for Saudi banks
  payoutBankName String?
  payoutSchedule String    @default("WEEKLY")
  restaurants   Restaurant[]
  warehouses    Warehouse[] // For grocery/cloud kitchens
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([taxNumber])
}

model Restaurant {
  id              String        @id @default(cuid())
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name            String
  nameAr          String?
  slug            String        @unique
  description     String?
  descriptionAr   String?
  cuisine         String[]      // ["ARABIC", "ITALIAN", "FAST_FOOD"]
  logo            String?
  banner          String?
  gallery         String[]
  phone           String
  email           String?
  address         String
  addressAr       String?
  city            String
  district        String?
  state           String?
  country         String        @default("Saudi Arabia")
  postalCode      String
  latitude        Decimal?
  longitude       Decimal?
  deliveryRadius  Decimal       @default(5.0) // km
  minOrderAmount  Decimal       @default(10.0)
  deliveryFee     Decimal       @default(3.99)
  freeDeliveryAbove Decimal?
  estimatedDeliveryTime Int     @default(30)
  minDeliveryTime Int           @default(20)
  maxDeliveryTime Int           @default(60)
  isOpen          Boolean       @default(true)
  openingHours    Json?         // { monday: {open: "09:00", close: "23:00"}, ... }
  holidayHours    Json?
  rating          Decimal       @default(0)
  totalReviews    Int           @default(0)
  totalOrders     Int           @default(0)
  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isVerified      Boolean       @default(false)
  badges          String[]      // ["FAST_DELIVERY", "POPULAR", "NEW"]
  categories      Category[]
  menuItems       MenuItem[]
  orders          Order[]
  promotions      RestaurantPromotion[]
  deliveryZones   DeliveryZone[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([merchantId])
  @@index([slug])
  @@index([isActive])
  @@index([city])
  @@index([rating])
  @@index([latitude, longitude])
}

model DeliveryZone {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String?
  polygon       Json?      // GeoJSON polygon
  fee           Decimal
  minOrder      Decimal
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId])
}

model Category {
  id          String     @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  description String?
  descriptionAr String?
  image       String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  menuItems   MenuItem[]
  modifierGroups ModifierGroup[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([restaurantId])
}

model ModifierGroup {
  id          String   @id @default(cuid())
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  description String?
  minSelection Int     @default(0)
  maxSelection Int     @default(1)
  isRequired  Boolean  @default(false)
  modifiers   Modifier[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model Modifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name            String
  nameAr          String?
  description     String?
  price           Decimal  @default(0)
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([modifierGroupId])
}

model MenuItem {
  id          String     @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  nameAr      String?
  description String?
  descriptionAr String?
  price       Decimal
  salePrice   Decimal?
  image       String?
  images      String[]
  isAvailable Boolean    @default(true)
  isVeg       Boolean?
  isHalal     Boolean    @default(true)
  isPopular   Boolean    @default(false)
  isFeatured  Boolean    @default(false)
  prepTime    Int?       // in minutes
  calories    Int?
  protein     Int?       // grams
  carbs       Int?       // grams
  fat         Int?       // grams
  allergens   String[]   // ["NUTS", "DAIRY", "GLUTEN"]
  ingredients String[]
  spiciness   Int?       // 0-5 scale
  portionSize String?    // "SMALL", "MEDIUM", "LARGE"
  sku         String?
  barcode     String?
  inventory   MenuItemInventory?
  customizations Json?
  modifierGroups ModifierGroup[]
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
}

model MenuItemInventory {
  id          String   @id @default(cuid())
  menuItemId  String   @unique
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity    Int
  lowStockThreshold Int @default(10)
  trackInventory Boolean @default(false)
  lastRestocked DateTime?
  updatedAt   DateTime @updatedAt

  @@index([menuItemId])
}

// ===========================================
// Ride Models
// ===========================================

model Ride {
  id              String      @id @default(cuid())
  rideNumber      String      @unique // Human-readable ride ID
  riderId         String
  rider           Customer    @relation("rider", fields: [riderId], references: [id], onDelete: Cascade)
  driverId        String?
  driver          Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status          RideStatus  @default(REQUESTED)
  category        RideCategory @default(REGULAR)
  
  // Pickup details
  pickupAddress   String
  pickupAddressAr String?
  pickupLatitude  Decimal
  pickupLongitude Decimal
  pickupName      String?    // Pickup location name
  pickupNameAr    String?
  pickupPhone     String?
  pickupNotes     String?
  pickupNotesAr   String?
  
  // Dropoff details
  dropoffAddress  String
  dropoffAddressAr String?
  dropoffLatitude Decimal
  dropoffLongitude Decimal
  dropoffName     String?
  dropoffNameAr   String?
  dropoffPhone    String?
  dropoffNotes    String?
  dropoffNotesAr  String?
  
  // Route & pricing
  distance        Decimal?    // in km
  duration        Int?        // in minutes
  route           Json?       // Encoded polyline
  vehicleType     VehicleType @default(ECONOMY)
  baseFare        Decimal
  distanceFare    Decimal
  timeFare        Decimal
  surgeMultiplier Decimal     @default(1.0)
  surgeReason     String?
  totalFare       Decimal
  discount        Decimal     @default(0)
  promoCodeId     String?
  tax             Decimal     @default(0)
  serviceFee      Decimal     @default(0)
  finalFare       Decimal
  driverEarnings  Decimal?
  
  // Payment
  paymentMethod   PaymentMethod?
  paymentId       String?
  payment         Payment?
  
  // Timing
  scheduledAt     DateTime?
  requestedAt     DateTime?
  acceptedAt      DateTime?
  driverArrivedAt DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  
  // Cancellation
  cancellationReason String?
  cancelledBy       String?
  cancellationFee   Decimal @default(0)
  
  // Additional info
  passengerCount  Int       @default(1)
  luggageCount    Int       @default(0)
  notes           String?
  notesAr         String?
  isForSomeoneElse Boolean  @default(false)
  recipientName   String?
  recipientPhone  String?
  rating          Int?
  driverRating    Int?
  riderRating     Int?
  tip             Decimal   @default(0)
  metadata        Json?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([riderId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledAt])
}

model RideRequest {
  id              String      @id @default(cuid())
  riderId         String
  pickupLatitude  Decimal
  pickupLongitude Decimal
  dropoffLatitude Decimal
  dropoffLongitude Decimal
  vehicleType     VehicleType
  category        RideCategory @default(REGULAR)
  status          String      @default("PENDING")
  estimatedFare   Decimal?
  nearbyDrivers   String[]    // Array of driver IDs notified
  expiresAt       DateTime
  createdAt       DateTime    @default(now())

  @@index([riderId])
  @@index([status])
  @@index([createdAt])
}

model RideShare {
  id              String   @id @default(cuid())
  rideId          String
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  additionalRiderId String
  pickupOrder     Int
  dropoffOrder    Int
  fare            Decimal
  createdAt       DateTime @default(now())

  @@index([rideId])
}

// ===========================================
// Order Models (Food, Grocery, Courier)
// ===========================================

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // Human-readable order ID
  type            OrderType   @default(FOOD)
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantId    String?
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  driverId        String?
  driver          Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PENDING)
  priority        DeliveryPriority @default(STANDARD)
  
  // Order details
  orderType       String      @default("DELIVERY") // DELIVERY or PICKUP
  items           OrderItem[]
  
  // Pricing
  subtotal        Decimal
  deliveryFee     Decimal
  serviceFee      Decimal
  tax             Decimal
  discount        Decimal     @default(0)
  promoCodeId     String?
  tip             Decimal     @default(0)
  total           Decimal
  
  // Payment
  paymentMethod   PaymentMethod
  paymentId       String?
  payment         Payment?
  paymentStatus   PaymentStatus @default(PENDING)
  
  // Delivery address
  deliveryAddress String?
  deliveryAddressAr String?
  deliveryLatitude Decimal?
  deliveryLongitude Decimal?
  deliveryInstructions String?
  deliveryInstructionsAr String?
  contactName     String?
  contactPhone    String?
  
  // Courier specific (for package delivery)
  packageSize     PackageSize?
  packageWeight   Decimal? // in kg
  packageValue    Decimal? // Declared value
  pickupContact   String?
  pickupPhone     String?
  pickupNotes     String?
  deliveryContact String?
  deliveryPhone   String?
  deliveryNotes   String?
  signatureRequired Boolean @default(false)
  idRequired      Boolean @default(false)
  
  // Timing
  scheduledAt     DateTime?
  estimatedDeliveryTime DateTime?
  confirmedAt     DateTime?
  preparingAt     DateTime?
  readyForPickupAt DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  
  // Cancellation
  cancellationReason String?
  cancelledBy     String?
  
  // Notes
  customerNotes   String?
  customerNotesAr String?
  restaurantNotes String?
  driverNotes     String?
  
  // Ratings
  rating          Int?
  restaurantRating Int?
  driverRating    Int?
  
  // Tracking
  trackingUrl     String?
  route           Json?
  metadata        Json?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([restaurantId])
  @@index([driverId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  quantity    Int
  unitPrice   Decimal
  modifiers   Json?    // Selected modifiers
  customizations Json?
  specialInstructions String?
  specialInstructionsAr String?
  totalPrice  Decimal
  status      String   @default("PENDING") // PENDING, PREPARING, READY, SERVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

// ===========================================
// Payment Models
// ===========================================

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal
  currency        String        @default("SAR")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  provider        String?       // "STRIPE", "PAYPAL", "HYPERPAY", "MOYASAR"
  providerPaymentId String?
  rideId          String?
  ride            Ride?         @relation(fields: [rideId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  walletTransactionId String?
  transactions    Transaction[]
  refunds         Refund[]
  installments    InstallmentPlan?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([rideId])
  @@index([orderId])
  @@index([createdAt])
}

model InstallmentPlan {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider        String   // "TABBY", "TAMARA"
  planId          String
  installments    Int
  installmentAmount Decimal
  frequency       String   // "WEEKLY", "BIWEEKLY", "MONTHLY"
  firstPaymentDate DateTime
  lastPaymentDate DateTime
  status          String   @default("ACTIVE")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentId])
}

model Transaction {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        String   // "CHARGE", "REFUND", "PAYOUT", "AUTHORIZATION"
  amount      Decimal
  status      String   @default("PENDING")
  provider    String?
  providerTransactionId String?
  gatewayResponse Json?
  errorCode   String?
  errorMessage String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paymentId])
  @@index([type])
  @@index([status])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Decimal
  reason      String
  reasonCode  String?
  status      String   @default("PENDING")
  providerRefundId String?
  requestedBy String?
  approvedBy  String?
  processedBy String?
  processedAt DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
}

model Wallet {
  id            String   @id @default(cuid())
  customerId    String   @unique
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance       Decimal  @default(0)
  currency      String   @default("SAR")
  pendingBalance Decimal @default(0)
  transactions  WalletTransaction[]
  autoTopup     Boolean  @default(false)
  autoTopupThreshold Decimal?
  autoTopupAmount Decimal?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // "CREDIT", "DEBIT"
  category    String   // "RIDE", "ORDER", "TOPUP", "REFUND", "PROMO", "CASHBACK"
  amount      Decimal
  balance     Decimal
  description String
  descriptionAr String?
  referenceId String?  // Order ID, Ride ID, etc.
  referenceType String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([referenceId])
  @@index([type])
}

// ===========================================
// Saved Card Models
// ===========================================

model SavedCard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String   // Gateway token for the card
  nickname      String   // User-defined nickname (e.g., "My Visa", "Work Card")
  brand         String   // VISA, MASTERCARD, AMEX, MADA, etc.
  last4         String   // Last 4 digits of card
  expiryMonth   String   // 2-digit month
  expiryYear    String   // 4-digit year
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastUsedAt    DateTime?
  metadata      Json?    // Additional card metadata from gateway
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([isDefault])
  @@index([brand])
}

model Earning {
  id          String   @id @default(cuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rideId      String?
  ride        Ride?    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount      Decimal
  type        String   // "RIDE", "DELIVERY", "TIP", "BONUS", "INCENTIVE"
  status      String   @default("PENDING") // PENDING, COMPLETED, PAID
  description String?
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([rideId])
  @@index([orderId])
  @@index([status])
}

// ===========================================
// Location Models
// ===========================================

model Location {
  id          String   @id @default(cuid())
  driverId    String?  @unique
  driver      Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude    Decimal
  longitude   Decimal
  heading     Decimal?  // degrees 0-360
  speed       Decimal?  // km/h
  accuracy    Decimal?  // meters
  altitude    Decimal?  // meters
  timestamp   DateTime @default(now())
  battery     Int?     // battery percentage
  isOnline    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([timestamp])
  @@index([latitude, longitude])
}

model LocationHistory {
  id          String   @id @default(cuid())
  entityType  String   // "DRIVER", "ORDER", "RIDE"
  entityId    String
  latitude    Decimal
  longitude   Decimal
  heading     Decimal?
  speed       Decimal?
  accuracy    Decimal?
  timestamp   DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([latitude, longitude])
}

model GeoFence {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  type        String   // "CITY", "DISTRICT", "AIRPORT", "RESTRICTED"
  polygon     Json?    // GeoJSON polygon
  centerLat   Decimal
  centerLng   Decimal
  radius      Decimal  // meters
  city        String
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([type])
}

model SurgePricing {
  id          String   @id @default(cuid())
  city        String
  area        String
  multiplier  Decimal
  reason      String
  isActive    Boolean  @default(true)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([isActive])
  @@index([startsAt, endsAt])
}

// ===========================================
// Notification Models
// ===========================================

model Notification {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  channel     NotificationType  @default(PUSH) // Primary delivery channel
  title       String
  titleAr     String?
  message     String
  messageAr   String?
  data        Json?
  action      String?           // Deep link or action
  imageUrl    String?
  status      NotificationStatus @default(PENDING)
  priority    String            @default("NORMAL") // NORMAL, HIGH
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  provider    String?           // "FCM", "TWILIO", "SENDGRID"
  providerMessageId String?
  error       String?
  retryCount  Int               @default(0)
  maxRetries  Int               @default(3)
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String
  type        NotificationType
  subject     String
  subjectAr   String?
  body        String
  bodyAr      String?
  variables   String[] // Available template variables
  isActive    Boolean  @default(true)
  category    String   // "ORDER", "RIDE", "PROMO", "SYSTEM"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([category])
}

// ===========================================
// Review Models
// ===========================================

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  String   // "DRIVER", "RESTAURANT", "CUSTOMER", "ORDER"
  targetId    String
  rideId      String?
  ride        Ride?    @relation(fields: [rideId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5
  categories  Json?    // { cleanliness: 5, driving: 4, punctuality: 5 }
  comment     String?
  commentAr   String?
  images      String[]
  response    String?
  responseAr  String?
  responseAt  DateTime?
  respondedBy String?
  isVisible   Boolean  @default(true)
  isVerified  Boolean  @default(false)
  helpfulCount Int     @default(0)
  reportedCount Int    @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([targetType, targetId])
  @@index([rideId])
  @@index([orderId])
  @@index([rating])
}

// ===========================================
// Admin Models
// ===========================================

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[]
  department  String?  // "OPERATIONS", "SUPPORT", "FINANCE", "TECH"
  roleId      String?
  role        AdminRole?
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  lastLoginIp String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([department])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     // { users: ["read", "write"], rides: ["read"] }
  admins      Admin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique
  customerId  String
  customer    User     @relation("createdBy", fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo  String?
  assignee    User?    @relation("assignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  type        String   // "GENERAL", "PAYMENT", "ORDER", "RIDE", "ACCOUNT"
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED
  subject     String
  description String
  category    String?
  orderId     String?
  rideId      String?
  paymentId   String?
  messages    SupportMessage[]
  resolvedAt  DateTime?
  resolvedBy  String?
  satisfactionRating Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([assignedTo])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  messageType String   @default("TEXT") // TEXT, IMAGE, FILE
  content     String
  attachments String[]
  isInternal  Boolean @default(false)
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([senderId])
}

// ===========================================
// Promo & Referral Models
// ===========================================

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  codeAr          String?
  description     String?
  descriptionAr   String?
  type            String   // "PERCENTAGE", "FIXED", "FREE_DELIVERY"
  value           Decimal
  minOrderAmount  Decimal?
  maxDiscount     Decimal?
  usageLimit      Int?
  usedCount       Int      @default(0)
  usageLimitPerUser Int?   @default(1)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  applicableServices String[] // ["RIDE", "FOOD", "GROCERY"]
  applicableCities String[]
  newUserOnly     Boolean  @default(false)
  firstOrderOnly  Boolean  @default(false)
  minRideFare     Decimal?
  excludedRestaurants String[]
  includedVehicles String[]
  campaignId      String?
  campaign        PromoCampaign?
  users           UserPromoCode[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

model PromoCampaign {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  description String?
  type        String   // "SEASONAL", "LAUNCH", "LOYALTY"
  startDate   DateTime
  endDate     DateTime
  budget      Decimal?
  spent       Decimal  @default(0)
  targetUsers Int?
  acquiredUsers Int    @default(0)
  isActive    Boolean  @default(true)
  promoCodes  PromoCode[]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

model UserPromoCode {
  id          String   @id @default(cuid())
  userId      String
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  orderId     String?
  rideId      String?
  createdAt   DateTime @default(now())

  @@unique([userId, promoCodeId])
  @@index([userId])
  @@index([promoCodeId])
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referrer        User     @relation("referrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId  String   @unique
  referredUser    User     @relation("referredBy", fields: [referredUserId], references: [id], onDelete: Cascade)
  code            String   @unique
  status          String   @default("PENDING") // PENDING, COMPLETED, EXPIRED
  rewardAmount    Decimal?
  rewardCurrency  String   @default("SAR")
  rewardPaid      Boolean  @default(false)
  paidAt          DateTime?
  referredUserCompletedAt DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([referrerId])
  @@index([referredUserId])
  @@index([code])
  @@index([status])
}

// ===========================================
// System Models
// ===========================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  changes   Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String?  // "GENERAL", "PAYMENT", "RIDE", "FOOD", "NOTIFICATION"
  description String?
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([category])
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  keyHash     String
  permissions String[]
  scopes      String[]
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)
  rateLimit   Int?     // requests per minute
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isActive])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // identifier (user IP, API key, etc.)
  count     Int      @default(0)
  limit     Int
  windowMs  Int      // time window in milliseconds
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([resetAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  rollout     Decimal  @default(1) // 0-1, percentage of users
  conditions  Json?    // Targeting conditions
  environments String[] // ["development", "staging", "production"]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([isEnabled])
}

model Analytics {
  id          String   @id @default(cuid())
  event       String
  entityType  String?  // "RIDE", "ORDER", "USER"
  entityId    String?
  userId      String?
  sessionId   String?
  properties  Json?
  value       Decimal?
  currency    String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

model City {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  slug        String   @unique
  country     String   @default("Saudi Arabia")
  state       String?
  latitude    Decimal
  longitude   Decimal
  timezone    String   @default("Asia/Riyadh")
  currency    String   @default("SAR")
  language    String   @default("ar")
  isActive    Boolean  @default(true)
  isLaunch    Boolean  @default(false)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

model Warehouse {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  type        String   @default("CLOUD_KITCHEN") // CLOUD_KITCHEN, GROCERY_HUB, DARK_STORE
  address     String
  addressAr   String?
  city        String
  latitude    Decimal
  longitude   Decimal
  radius      Decimal  @default(5.0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([city])
}

model RestaurantPromotion {
  id          String   @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  type        String   // "DISCOUNT", "BOGO", "FREE_ITEM"
  description String?
  descriptionAr String?
  value       Decimal
  minOrder    Decimal?
  maxDiscount Decimal?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([restaurantId])
  @@index([isActive])
}

// Join table for many-to-many
model RestaurantPromotionCode {
  id          String   @id @default(cuid())
  promotionId String
  promoCodeId String
  createdAt   DateTime @default(now())

  @@unique([promotionId, promoCodeId])
  @@index([promotionId])
  @@index([promoCodeId])
}
