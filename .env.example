# ===========================================
# TATX Super-App Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ===========================================
# Global Settings
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tatx?schema=public"
DATABASE_POOL_SIZE=10

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# JWT & Authentication
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# API Keys & Third Party Services
# ===========================================
# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_API_SECRET=your-google-maps-api-secret

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Twilio (SMS/Phone)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@tatx.com

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key

# ===========================================
# Service URLs (Internal Microservices)
# ===========================================
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
DRIVER_SERVICE_URL=http://localhost:3003
RIDE_SERVICE_URL=http://localhost:3004
FOOD_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
LOCATION_SERVICE_URL=http://localhost:3009
ADMIN_SERVICE_URL=http://localhost:3010

# ===========================================
# Frontend URLs
# ===========================================
CUSTOMER_APP_URL=http://localhost:3100
DRIVER_APP_URL=http://localhost:3101
MERCHANT_APP_URL=http://localhost:3102
ADMIN_DASHBOARD_URL=http://localhost:3103

# ===========================================
# File Storage (S3 Compatible)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tatx-uploads
STORAGE_ENDPOINT=

# ===========================================
# Map Services
# ===========================================
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
HERE_API_KEY=your-here-api-key

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=debug
SENTRY_DSN=your-sentry-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=

# ===========================================
# Encryption
# ===========================================
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ===========================================
# Session Configuration
# ===========================================
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# ===========================================
# CORS Settings
# ===========================================
CORS_ORIGIN=http://localhost:3100,http://localhost:3101,http://localhost:3102,http://localhost:3103

# ===========================================
# Email Configuration
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Tatx
SMTP_FROM_EMAIL=noreply@tatx.com

# ===========================================
# Push Notification
# ===========================================
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tatx.app
APNS_KEY_PATH=

# ===========================================
# Feature Flags
# ===========================================
ENABLE_RIDE_SHARING=true
ENABLE_FOOD_DELIVERY=true
ENABLE_PACKAGE_DELIVERY=true
ENABLE_SCHEDULED_RIDES=true
ENABLE_MULTI_STOP=true

# ===========================================
# Pricing Configuration
# ===========================================
BASE_RIDE_FARE=2.5
PER_KM_RATE=1.5
PER_MINUTE_RATE=0.35
MINIMUM_FARE=5.0
SURGE_MULTIPLIER=1.0
DELIVERY_FEE=3.99
SERVICE_FEE_PERCENT=0.15

# ===========================================
# Driver Settings
# ===========================================
MIN_DRIVER_RATING=4.0
MAX_RIDE_DISTANCE_KM=50
MAX_DELIVERY_DISTANCE_KM=10

# ===========================================
# Cache Settings
# ===========================================
CACHE_TTL=3600
CACHE_PREFIX=tatx:
